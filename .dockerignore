# Keep private runtime content out of Docker build contexts and images.
.git
.env
.env.*
data/*
!data/
.hugo-data/
content/posts/
content/friends/
content/tags/
static/uploads/*
!static/uploads/admin/
static/md-source/
# The repository carries a public snapshot so a fresh clone renders the same
# public site. Local-only source material and temporary media stay out of images.
local-only/
static/runtime-config.js
published/
resources/
deploy/verify_v*.sh
deploy/deploy_v*_safe.sh
deploy/install_*_v*.sh
deploy/nginx-*-v*.conf

# Local/editor files.
.DS_Store
Thumbs.db
*.pem
*.key
id_rsa
id_rsa.pub
