# 运行 deploy/init-local.ps1 创建仅保存在本机的真实 .env 文件。
# Docker Compose 和直接运行 Go 程序都会读取本文件；进程环境变量优先。
# 每次服务启动都会将 ADMIN_PASS 应用到该管理员；修改后重启即可轮换密码。
ADDR=:8080
ADMIN_USER=
ADMIN_PASS=
SESSION_SECRET=

# 可选 URL 配置。
ADMIN_BASE_PATH=/write
PUBLIC_BASE_URL=/
PUBLIC_SITE_URL=
PUBLIC_API_URL=
# 允许调用公开成绩接口的浏览器来源，多个值用英文逗号分隔。
PUBLIC_CORS_ORIGINS=

# 可选运行参数；默认值保持当前行为不变。
HUGO_BUILD_TIMEOUT_SECONDS=180
MAX_UPLOAD_BYTES=536870912
# 媒体上传和上传后重建允许的 HTTP 超时（秒）。
HTTP_READ_TIMEOUT_SECONDS=900
HTTP_WRITE_TIMEOUT_SECONDS=900
# 服务器可将运行时媒体放到发布版本外，避免 Hugo 扫描符号链接。
RUNTIME_STATIC_DIR=static
