# Run deploy/init-local.ps1 to create the real local-only .env file.
# Docker Compose and direct Go runs load this file; process environment values
# take priority over it. ADMIN_PASS is applied to this administrator each time
# the service starts, so change it here and restart to rotate the password.
ADDR=:8080
ADMIN_USER=
ADMIN_PASS=
SESSION_SECRET=

# Optional URL settings.
ADMIN_BASE_PATH=
PUBLIC_BASE_URL=/
PUBLIC_SITE_URL=
PUBLIC_API_URL=
# Comma-separated browser origins allowed to call public score APIs.
PUBLIC_CORS_ORIGINS=
