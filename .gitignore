# Runtime instances and generated builds are local to each deployment.
/runtime/*
!/runtime/.gitignore
/build/*
!/build/.gitignore
/local-only/
/blog-admin

# Legacy runtime directories remain ignored during upgrades.
/data/
/content/
/static/
/published/
/resources/
/hugo-data/
/.hugo-workspace/
.hugo_build.lock

# Only fixed pages and public seed media belong in frontend sources.
/frontend/site/content/posts/
/frontend/site/content/friends/
/frontend/site/content/tags/
/frontend/site/static/uploads/*
!/frontend/site/static/uploads/admin/
/frontend/site/static/md-source/
/frontend/site/static/runtime-config.js

.env
.env.*
!.env.example
deploy/*.local.sh
deploy/*.local.ps1
.DS_Store
Thumbs.db
*.pem
*.key
id_rsa
id_rsa.pub
