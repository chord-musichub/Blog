# 复制为 /opt/songline-blog/shared/blog-admin.env，设置安全权限后，
# 在启动 systemd 服务前替换所有实际值。此文件不提交到 Git。
ADDR=127.0.0.1:8080
DATA_DIR=/opt/songline-blog/shared/data
HUGO_CONTENT_DIR=/opt/songline-blog/shared/content/posts
PUBLIC_DIR=./published
HUGO_COMMAND=hugo --minify --source . --destination ./published
ADMIN_USER=
ADMIN_PASS=
SESSION_SECRET=
ADMIN_BASE_PATH=/write
PUBLIC_BASE_URL=/
PUBLIC_SITE_URL=https://blog.songline-blog.com
PUBLIC_API_URL=https://blog.songline-blog.com
PUBLIC_CORS_ORIGINS=https://blog.songline-blog.com
HUGO_BUILD_TIMEOUT_SECONDS=180
MAX_UPLOAD_BYTES=536870912
