# 将此示例中的证书路径替换为当前线上 Nginx 配置中已经可用的路径。
# public 域名统一承载公开站、/write/ 后台、/api/ 公开接口。

server {
    listen 80;
    server_name blog.songline-blog.com write.songline-blog.com;
    root /var/www/letsencrypt;

    location ^~ /.well-known/acme-challenge/ {
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name blog.songline-blog.com;
    client_max_body_size 512m;

    # ssl_certificate /etc/letsencrypt/live/blog.songline-blog.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/blog.songline-blog.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /opt/songline-blog/current/published;
    index index.html;

    # 模板为 CSS/JS 附带 Git 版本号查询参数；仅这两类构建资源长期缓存。
    # 不缓存 HTML、文章、上传文件，保证后台发布内容能立即更新。
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location ^~ /css/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    location ^~ /js/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    location = /write {
        return 301 /write/;
    }

    # 尾部斜杠会移除 /write/ 前缀，与 ADMIN_BASE_PATH=/write 相匹配。
    location ^~ /write/ {
        proxy_pass http://127.0.0.1:8080/;
        proxy_request_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /static/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Markdown 源文件是运行时数据；不能落入下方的 /index.html 兜底规则。
    location ^~ /md-source/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 上传文件属于运行时数据，不在 Hugo 的 published 目录中；交由后台服务提供。
    location ^~ /uploads/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /healthz {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# 保留旧后台域名，避免旧书签和已保存的入口失效。
server {
    listen 443 ssl http2;
    server_name write.songline-blog.com;

    # ssl_certificate /etc/letsencrypt/live/write.songline-blog.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/write.songline-blog.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://blog.songline-blog.com/write/;
}
