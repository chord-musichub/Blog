[Unit]
Description=Songline Blog Admin (stable release)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/opt/songline-blog/current/blog-admin

[Service]
Type=simple
User=blog
Group=blog
WorkingDirectory=/opt/songline-blog/current
EnvironmentFile=/opt/songline-blog/shared/blog-admin.env
ExecStart=/opt/songline-blog/current/blog-admin
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/songline-blog

[Install]
WantedBy=multi-user.target
